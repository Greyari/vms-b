APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# PostgreSQL 18 di semua lingkungan. Dev lokal: container postgres-lokal, database `vms`
# (test PostgreSQL memakai `vms_test`). Server yard: database `db_vms`, user `vms_app`
# (bukan superuser) — lihat docs/vms-multi-yard-setup-runbook.md di repo suite.
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=vms
DB_USERNAME=postgres
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# --- Azure Blob Storage -------------------------------------------------------
# Filesystem container App Service bersifat ephemeral: berkas di disk lokal
# hilang saat restart dan tidak terlihat instance lain, tanpa error apa pun.
# Di Azure set FILESYSTEM_DISK=azure dan biarkan CONNECTION_STRING kosong --
# otentikasi memakai Managed Identity, jadi tidak ada account key di mana pun.
# Identity app wajib punya peran "Storage Blob Data Contributor" di sabtapps.
AZURE_STORAGE_BLOB_ENDPOINT=https://sabtapps.blob.core.windows.net
AZURE_STORAGE_CONTAINER=vms-uploads
AZURE_STORAGE_PREFIX=
# Hanya untuk lokal/compose (Azurite atau account key). KOSONGKAN di produksi.
AZURE_STORAGE_CONNECTION_STRING=

# --- Proxy tepercaya (config/trustedproxy.php) -------------------------------
# Server lokal di LAN: kosongkan. (Gerbang tidak lagi berjalan di Azure sejak keputusan B-3.)
TRUSTED_PROXIES=

# --- Akun awal (RoleAndPermissionSeeder) --------------------------------------
# Password diisi per mesin; jangan pernah di-commit.
VMS_ADMIN_EMAIL=admin@vms.local
VMS_ADMIN_NAME="VMS Admin"
VMS_ADMIN_PASSWORD=
VMS_SECURITY_EMAIL=security@vms.local
VMS_SECURITY_NAME="VMS Security"
VMS_SECURITY_PASSWORD=

# --- Cloud Hub sync (hybrid multi-yard, decision BE-6) ---------------------------
# Off until the go-live checklist of docs/vms-multi-yard-setup-runbook.md passes. Task Scheduler
# (tools/windows/setup-sync-task.ps1) runs `php artisan vms:sync-cloud-hub` every minute.
# VMS_CLOUD_HUB_URL = https://<static web app hostname>/api/v1 (decision PE-11-HOST).
# The key id and secret come from Key Vault secret vms-sync-hmac-<yard>; never commit them.
VMS_SYNC_ENABLED=false
VMS_YARD_CODE=
VMS_CLOUD_HUB_URL=
VMS_CLOUD_HMAC_KEY_ID=
VMS_CLOUD_HMAC_SECRET=

# --- Yard branding (decision PE-7) -----------------------------------------------
# One SPA build serves every yard; this server's company goes on the printed pass and the
# visitor report PDF. The logo is a file NAME inside public/branding/ (copied there at install,
# never shipped in the release ZIP); leave it empty for no logo.
VMS_COMPANY_NAME=
VMS_COMPANY_ADDRESS=
VMS_COMPANY_LOGO=
