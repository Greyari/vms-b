# Kunci penandatangan Passport dan lampiran ber-PII tidak pernah masuk image:
# COPY . . di stage vendor akan memanggangnya, dan siapa pun yang bisa menarik
# image itu bisa menandatangani access token untuk user mana pun. Kunci dipasok
# saat runtime lewat PASSPORT_PRIVATE_KEY / PASSPORT_PUBLIC_KEY.
storage/*.key
*.key
*.pem
storage/app/private/*
tests
.phpunit.cache
Dockerfile
docker-compose*.yml
bootstrap/cache/*
# Paket server Windows dan runbook - tidak dipakai di image container
tools
docs
