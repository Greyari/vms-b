<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <system.webServer>

        <rewrite>
            <rules>
                <clear />

                <!--
                    Rule 1: Tangani CORS preflight (OPTIONS) langsung di IIS.
                    Kembalikan 200 OK seketika — tidak perlu sampai ke PHP.
                    CORS headers sudah disertakan lewat <httpProtocol> di bawah.
                    Ini memastikan preflight berhasil bahkan saat PHP error.
                -->
                <rule name="CORS Preflight" stopProcessing="true">
                    <match url=".*" />
                    <conditions>
                        <add input="{REQUEST_METHOD}" pattern="^OPTIONS$" />
                    </conditions>
                    <action type="CustomResponse" statusCode="200" statusReason="OK" statusDescription="OK" />
                </rule>

                <!-- Rule 2: Redirect trailing slash (kecuali folder) -->
                <rule name="VMS Trailing Slash" stopProcessing="true">
                    <match url="^(.*)/$" ignoreCase="false" />
                    <conditions>
                        <add input="{REQUEST_FILENAME}" matchType="IsDirectory" ignoreCase="false" negate="true" />
                    </conditions>
                    <action type="Redirect" redirectType="Permanent" url="/{R:1}" />
                </rule>

                <!-- Rule 3: Laravel Front Controller — semua request ke index.php -->
                <rule name="VMS Front Controller" stopProcessing="true">
                    <match url="^" ignoreCase="false" />
                    <conditions logicalGrouping="MatchAll">
                        <add input="{REQUEST_FILENAME}" matchType="IsDirectory" ignoreCase="false" negate="true" />
                        <add input="{REQUEST_FILENAME}" matchType="IsFile"      ignoreCase="false" negate="true" />
                    </conditions>
                    <action type="Rewrite" url="index.php" />
                </rule>

            </rules>
        </rewrite>

        <!--
            CORS Headers — disertakan di SEMUA response dari /vms/.
            Strategi ini memastikan CORS header hadir bahkan saat PHP error (500, 404, dll),
            sehingga browser tidak memblokir request dari vms.cemaraintan.id.

            CATATAN: cors.php di Laravel di-disable untuk production (APP_ENV=production)
                     agar tidak ada duplicate CORS headers (IIS + Laravel = conflict).
        -->
        <httpProtocol>
            <customHeaders>
                <add name="Access-Control-Allow-Origin"  value="https://vms.cemaraintan.id" />
                <add name="Access-Control-Allow-Methods" value="GET, POST, PUT, PATCH, DELETE, OPTIONS, HEAD" />
                <add name="Access-Control-Allow-Headers" value="Content-Type, Authorization, X-Requested-With, Accept, X-XSRF-TOKEN" />
                <add name="Access-Control-Max-Age"       value="86400" />
            </customHeaders>
        </httpProtocol>

        <handlers>
            <clear />

            <!--
                PHP 8.3 handler dengan verb="*":
                Memungkinkan PUT, PATCH, DELETE, OPTIONS semua diproses oleh PHP/Laravel.
                Sebelumnya hanya GET,HEAD,POST — itu penyebab 405 untuk update/delete API.
            -->
            <add name="php-8.3.30"
                 path="*.php"
                 verb="*"
                 modules="FastCgiModule"
                 scriptProcessor="C:\php\php-8.3.30-Win32-vs16-x64\php-cgi.exe"
                 resourceType="Either"
                 requireAccess="Script" />

            <!-- Static file handler: melayani JS, CSS, gambar, font, dll. -->
            <add name="StaticFile"
                 path="*"
                 verb="*"
                 modules="StaticFileModule,DefaultDocumentModule,DirectoryListingModule"
                 resourceType="Either"
                 requireAccess="Read" />

        </handlers>

        <defaultDocument>
            <files>
                <clear />
                <add value="index.php" />
                <add value="index.html" />
            </files>
        </defaultDocument>

    </system.webServer>
</configuration>
